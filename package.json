{
  "name": "dsh-feiyufm-core",
  "version": "0.1.0-beta.2",
  "type": "module",
  "description": "肥鱼电台 FishFM：DSH 社区音乐插件，从参考歌曲出发，由网易云推荐、模型筛选，再自主听歌。",
  "license": "MIT",
  "os": [
    "win32"
  ],
  "files": [
    "index.js",
    "cordis.patch.yml",
    "bin/fishfm-core.mjs",
    "src/**/*.mjs",
    "src/ui/dsh-client.js",
    "src/playback/host/wpf-media-host.ps1",
    "src/ui/assets/whale-idle.png",
    "src/ui/assets/whale-listening.png",
    "src/ui/assets/whale-dj.png",
    "src/ui/assets/whale-pot-dance.gif",
    "src/ui/assets/whale-pot-still.png",
    "src/ui/assets/dolls/*.png",
    "THIRD_PARTY_NOTICES.md",
    "DEPENDENCY_LICENSES.md",
    "assets/readme/",
    "npm-shrinkwrap.json",
    "docs/DELIVERY.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A7m0spHere/dsh-feiyuFM.git"
  },
  "homepage": "https://github.com/A7m0spHere/dsh-feiyuFM#readme",
  "bugs": {
    "url": "https://github.com/A7m0spHere/dsh-feiyuFM/issues"
  },
  "keywords": [
    "fishfm",
    "deepseek",
    "deepseek-harness",
    "music",
    "netease",
    "dsh-plugin"
  ],
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./src/ui/dsh-client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "external": [
        "react"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "meta": {
    "title": "肥鱼电台 FishFM",
    "description": "给正在 DSH 里工作的 DeepSeek 一副耳机：本地选歌、独立的播放服务，用户始终保留控制权。"
  },
  "scripts": {
    "prepack": "npm run build:client && node scripts/dependency-notices.mjs && npm run check",
    "prepublishOnly": "npm test && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-timeout=30000",
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs",
    "preview:ui": "node scripts/ui-preview.mjs",
    "debug": "node bin/fishfm-debug.mjs",
    "core": "node bin/fishfm-core.mjs",
    "login": "node scripts/login.mjs",
    "soak": "node scripts/soak.mjs",
    "observe:runtime": "node scripts/observe-runtime.mjs",
    "verify:lifecycle": "node scripts/verify-lifecycle.mjs",
    "audit:acceptance": "node scripts/audit-acceptance.mjs",
    "smoke:playback": "node scripts/playback-smoke.mjs"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.40.1",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "basic-ftp": "6.2.2"
  },
  "bundleDependencies": [
    "@neteasecloudmusicapienhanced/api",
    "qrcode"
  ]
}
