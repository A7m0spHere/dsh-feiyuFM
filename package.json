{
  "name": "dsh-feiyufm-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FishFM music persona for the DeepSeek Harness: local queue, taste and playback, with NetEase and QQ as the target platforms.",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./src/ui/dsh-client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "external": [
        "react"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "meta": {
    "title": "肥鱼电台 FishFM",
    "description": "给正在 DSH 里工作的 DeepSeek 一副耳机：本地选歌、独立的播放服务，用户始终保留控制权。"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test --test-timeout=30000",
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs",
    "preview:ui": "node scripts/ui-preview.mjs",
    "debug": "node bin/fishfm-debug.mjs",
    "core": "node bin/fishfm-core.mjs",
    "login": "node scripts/login.mjs",
    "soak": "node scripts/soak.mjs",
    "observe:runtime": "node scripts/observe-runtime.mjs",
    "verify:lifecycle": "node scripts/verify-lifecycle.mjs",
    "audit:acceptance": "node scripts/audit-acceptance.mjs",
    "smoke:playback": "node scripts/playback-smoke.mjs"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.40.1",
    "qrcode": "^1.5.4"
  }
}
